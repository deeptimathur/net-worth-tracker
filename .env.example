# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/networth

# 32 random bytes, base64. Wraps every user's data key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes all stored balances unreadable. Keep it in your host's secret store.
APP_ENCRYPTION_KEY=

# Daily FX source (ECB reference rates, free, no key). Optional override.
FX_API_URL=https://api.frankfurter.dev/v1/latest
