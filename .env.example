# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/networth

# 32 random bytes, base64. Wraps every user's data key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes all stored balances unreadable. Keep it in your host's secret store.
APP_ENCRYPTION_KEY=

# Daily FX source (ECB reference rates, free, no key). Optional override.
FX_API_URL=https://api.frankfurter.dev/v1/latest

# Public URL of the app, e.g. https://networth.example.com (used for the Google redirect URI)
APP_URL=http://localhost:3000

# Sign in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Plaid (dashboard.plaid.com > Developers > Keys). PLAID_ENV is sandbox or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Only needed for OAuth banks (e.g. Chase) in production: an https page registered in the Plaid dashboard.
PLAID_REDIRECT_URI=

# Protects the daily balance refresh endpoint. Vercel Cron sends it automatically.
CRON_SECRET=
